{
  "expo": {
    "name": "Growth Mobile",
    "slug": "growth-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#86ef5b"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.growth.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#86ef5b"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以上传头像",
          "cameraPermission": "允许使用相机拍摄头像"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "b6bc2a48-a10f-49a2-844c-8298a49a405d"
      }
    }
  }
}
